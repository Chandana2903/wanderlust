<% layout('./layouts/boilerplate') %>
<!-- BACK BUTTON -->
<div class="mb-3">
  <a
    href="javascript:history.back()"
    class="btn btn-light border d-inline-flex align-items-center gap-2"
  >
    <i class="fa-solid fa-arrow-left"></i>
    Back
  </a>
</div>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

      <h2 class="text-center mb-4 fw-bold">Create an Account</h2>

      <form action="/users/signup" method="POST">

        <!-- Username -->
        <div class="mb-3">
          <label class="form-label">Username</label>
          <input
            type="text"
            name="username"
            class="form-control form-control-lg"
            placeholder="Enter username"
            required
          >
        </div>

        <!-- Email -->
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input
            type="email"
            name="email"
            class="form-control form-control-lg"
            placeholder="Enter email"
            required
          >
        </div>

        <!-- Password -->
        <div class="mb-4">
          <label class="form-label">Password</label>
          <input
            type="password"
            name="password"
            class="form-control form-control-lg"
            placeholder="Enter password"
            required
          >
        </div>

        <!-- Signup Button -->
        <button class="btn btn-lg w-100 signup-btn" style="background-color: greenyellow">
          Sign Up
        </button>

      </form>

      <p class="text-center mt-3">
        Already have an account?
        <a href="/users/login" class="text-decoration-none">
          Login
        </a>
      </p>

    </div>
  </div>
</div>
