<% layout('./layouts/boilerplate') %>
<!-- BACK BUTTON -->
<div class="mb-3">
  <a
    href="javascript:history.back()"
    class="btn btn-light border d-inline-flex align-items-center gap-2"
  >
    <i class="fa-solid fa-arrow-left"></i>
    Back
  </a>
</div>

<div class="container mt-4">
  <h2 class="mb-4">My Listings</h2>

  <% if (listings.length === 0) { %>
    <p class="text-muted">You have not created any listings yet.</p>
    <a href="/listings/new" class="btn btn-success">Create your first listing</a>
  <% } %>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-2">
    <% listings.forEach(listing => { %>

      <div class="col">
        <div class="card h-100 shadow-sm">

          <img
            src="<%= listing.image?.url %>"
            class="card-img-top"
            style="height: 180px; object-fit: cover;"
          >

          <div class="card-body">
            <h5 class="card-title"><%= listing.title %></h5>
            <p class="text-muted"><%= listing.location %></p>

            <div class="d-flex justify-content-between">
              <a
                href="/listings/<%= listing._id %>"
                class="btn btn-sm btn-outline-primary"
              >
                View
              </a>

              <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-sm btn-outline-secondary"
              >
                Edit
              </a>

              <form
                action="/listings/<%= listing._id %>?_method=DELETE"
                method="POST"
                onsubmit="return confirm('Delete this listing?')"
              >
                <button class="btn btn-sm btn-outline-danger">
                  Delete
                </button>
              </form>
            </div>

          </div>
        </div>
      </div>

    <% }) %>
  </div>
</div>
