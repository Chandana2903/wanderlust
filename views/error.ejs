<% layout("./layouts/boilerplate") %>

<div class="container mt-5">
  <div class="alert alert-danger text-center">
    <h4 class="mb-3">Something went wrong 😕</h4>
    <p><%= err.message || "Unexpected Error" %></p>

    <% if (err.statusCode) { %>
      <small class="text-muted">Status Code: <%= err.statusCode %></small>
    <% } %>

    <div class="mt-4">
      <a href="/listings" class="btn btn-dark">Go Back</a>
    </div>
  </div>
</div>
