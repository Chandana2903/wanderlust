<% layout('layouts/boilerplate') %>

<div class="container mt-4">

  <a href="javascript:history.back()" class="btn btn-light mb-3">
    ← Back
  </a>

  <h4>Stays near <%= plan.location %></h4>

  <% if (listings.length === 0) { %>
    <p class="text-muted">No accommodations available yet 😕</p>
  <% } %>

  <div class="row g-4 mt-2">
    <% listings.forEach(listing => { %>
      <div class="col-md-4">
        <div class="card h-100">
          <img src="<%= listing.image.url %>" class="card-img-top">
          <div class="card-body">
            <h6><%= listing.title %></h6>
            <p class="fw-bold">₹<%= listing.price %></p>
            <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-primary">
              View
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

</div>
