<% layout('layouts/boilerplate') %>

<div class="container my-5">

  <!-- BACK BUTTON -->
  <div class="mb-3">
    <a
      href="/listings"
      class="btn btn-light border d-inline-flex align-items-center gap-2"
    >
      <i class="fa-solid fa-arrow-left"></i>
      Back to listings
    </a>
  </div>

  <h3 class="text-center mb-4">Create a New Listing</h3>

  <form
    action="/listings"
    method="POST"
    enctype="multipart/form-data"
    class="mx-auto p-4 border rounded shadow-sm"
    style="max-width: 600px; background-color: #f9f9f9;"
  >

    <!-- TITLE -->
    <div class="mb-3">
      <label class="form-label">Title</label>
      <input
        type="text"
        name="listing[title]"
        class="form-control"
        placeholder="Listing title"
        required
      >
    </div>

    <!-- DESCRIPTION -->
    <div class="mb-3">
      <label class="form-label">Description</label>
      <textarea
        name="listing[description]"
        class="form-control"
        rows="3"
        placeholder="Describe your listing"
        required
      ></textarea>
    </div>

    <!-- IMAGE -->
    <div class="mb-3">
      <label class="form-label">Upload Image</label>
      <input
        type="file"
        name="image"
        class="form-control"
        accept="image/*"
        required
      >
    </div>

    <!-- CATEGORY -->
    <div class="mb-3">
      <label class="form-label">Category</label>
      <select name="listing[category]" class="form-select" required>
        <option value="" disabled selected>Select category</option>
        <option value="Rooms">Rooms</option>
        <option value="Iconic Cities">Iconic Cities</option>
        <option value="Mountains">Mountains</option>
        <option value="Castles">Castles</option>
        <option value="Amazing Pools">Amazing Pools</option>
        <option value="Camping">Camping</option>
        <option value="Farms">Farms</option>
        <option value="Arctic">Arctic</option>
        <option value="Domes">Domes</option>
        <option value="Boats">Boats</option>
      </select>
    </div>

    <!-- PRICE -->
    <div class="mb-3">
      <label class="form-label">Price</label>
      <input
        type="number"
        name="listing[price]"
        class="form-control"
        placeholder="Price per night"
        required
      >
    </div>

    <!-- LOCATION -->
    <div class="mb-3">
      <label class="form-label">Location</label>
      <input
        type="text"
        name="listing[location]"
        class="form-control"
        placeholder="City / Area"
        required
      >
    </div>

    <!-- COUNTRY -->
    <div class="mb-3">
      <label class="form-label">Country</label>
      <input
        type="text"
        name="listing[country]"
        class="form-control"
        placeholder="Country"
        required
      >
    </div>

    <!-- ACTION -->
    <div class="text-center">
      <button type="submit" class="btn btn-success px-4">
        Add Listing
      </button>
    </div>

  </form>
</div>
<!-- Fullscreen Loading Overlay -->
<div id="loadingOverlay" style="
  position: fixed;
  inset: 0;
  background: rgba(255,255,255,0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  font-size: 1.5rem;
  font-weight: bold;
  color: #444;
  display: none;
">
  <div class="spinner-border text-primary" role="status"></div>
  <span class="ms-3">Processing...</span>
</div>

