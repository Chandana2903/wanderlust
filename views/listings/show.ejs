<% layout("./layouts/boilerplate") %>
<% bodyClass = "show-page" %>

<!-- ================= BACK BUTTON ================= -->
<div class="container mt-3 mb-2">
  <a href="javascript:history.back()" class="btn btn-light border d-inline-flex align-items-center gap-2">
    <i class="fa-solid fa-arrow-left"></i>
    Back
  </a>
</div>

<!-- ================= LISTING ================= -->
<div class="card mx-auto shadow-sm mb-4 show-listing-card" style="max-width:650px;">
  <img
    src="<%= listing.image.url %>"
    class="card-img-top show-clickable-img"
    id="listingImage"
    alt="listing image"
    style="height:260px; object-fit:cover;"
  />

  <div class="card-body text-center">
    <h4 class="mb-1"><%= listing.title %></h4>
    <p class="mt-3 mb-0"><%= listing.description %></p>
    <p class="mt-3 fw-bold fs-4 text-danger">₹<%= listing.price.toLocaleString("en-IN") %> / night</p>
  </div>
</div>

<!-- ================= IMAGE MODAL ================= -->
<div id="imageModal" class="image-modal">
  <span class="close-modal" id="closeModal">&times;</span>
  <img class="image-modal-content" id="modalImage">
</div>

<!-- ================= OWNER ACTIONS ================= -->
<% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
  <div class="mx-auto mb-4 d-flex gap-2 justify-content-center" style="max-width:650px;">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary btn-sm">Edit</a>
    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this listing?')">
      <button class="btn btn-outline-danger btn-sm">Delete</button>
    </form>
  </div>
<% } %>

<!-- ================= BOOKING FORM WITH PRICE CALCULATION ================= -->
<% if (currUser) { %>
<div class="mx-auto mb-4" style="max-width:650px;">
  <div class="card shadow-sm p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-semibold mb-0">Reserve this stay</h5>
      <span class="fs-5 fw-bold text-danger">₹<%= listing.price.toLocaleString("en-IN") %> / night</span>
    </div>

    <form id="bookingForm" action="/bookings/<%= listing._id %>" method="POST" class="row g-3">
      <div class="col-md-6">
        <label class="form-label small text-muted">Check-in</label>
        <div class="position-relative">
          <i class="fa-solid fa-calendar-days position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
          <input type="date" name="checkIn" id="checkIn" class="form-control ps-5" required>
        </div>
      </div>

      <div class="col-md-6">
        <label class="form-label small text-muted">Check-out</label>
        <div class="position-relative">
          <i class="fa-solid fa-calendar-days position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
          <input type="date" name="checkOut" id="checkOut" class="form-control ps-5" required>
        </div>
      </div>

      <!-- Price Breakdown -->
      <div class="col-12 mt-3">
        <div class="bg-light p-3 rounded">
          <div class="d-flex justify-content-between mb-2">
            <span>Nights:</span>
            <strong id="nightsCount">0</strong>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>Price per night:</span>
            <strong>₹<%= listing.price.toLocaleString("en-IN") %></strong>
          </div>
          <hr>
          <div class="d-flex justify-content-between fs-5 fw-bold">
            <span>Total:</span>
            <strong id="totalPrice" class="text-danger">₹0</strong>
          </div>
        </div>
      </div>

      <div class="col-12">
        <button type="submit" class="btn btn-danger w-100 py-2" id="reserveBtn" disabled>Reserve</button>
      </div>

      <p class="text-muted small text-center mt-1">
        Booking for today or past dates is not allowed.
      </p>
    </form>
  </div>
</div>
<% } else { %>
<p class="text-center">
  <a href="/users/login">Login</a> to book this stay
</p>
<% } %>

<!-- ================= REVIEWS ================= -->
<div class="mx-auto mb-4" style="max-width:650px;">

  <h3 class="mb-3">Reviews</h3>

  <% if (listing.reviews.length === 0) { %>
    <p class="text-muted text-center">No reviews yet. Be the first!</p>
  <% } %>

  <% listing.reviews.forEach(review => { %>
    <div class="card shadow-sm p-3 mb-3">

      <!-- Username -->
      <h6 class="fw-semibold mb-1">
        @<%= review.author ? review.author.username : "DeletedUser" %>
      </h6>

      <!-- Animated Stars (Read Only) -->
      <div class="starability-result animated-stars" data-rating="<%= review.rating %>"></div>

      <!-- Comment -->
      <p class="mt-2 mb-2"><%= review.comment %></p>

      <!-- ===== USER OWN REVIEW ACTIONS ===== -->
      <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
      <div class="d-flex gap-2 mt-2">

        <!-- DELETE -->
        <form 
          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" 
          method="POST"
          onsubmit="return confirm('Delete this review?')"
        >
          <button class="btn btn-sm btn-outline-danger review-btn">
            Delete
          </button>
        </form>

        <!-- EDIT TOGGLE -->
        <button 
          class="btn btn-sm btn-outline-primary review-btn"
          onclick="document.getElementById('editForm-<%= review._id %>').classList.toggle('d-none')"
        >
          Edit
        </button>

      </div>

      <!-- ===== EDIT FORM ===== -->
      <form 
        id="editForm-<%= review._id %>" 
        class="card card-body mt-3 d-none"
        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=PUT"
        method="POST"
      >

        <h6>Edit Review</h6>

        <!-- Animated Stars -->
        <fieldset class="starability-heart animated-rate">
          <% for (let i = 1; i <= 5; i++) { %>
            <input 
              type="radio" 
              id="edit-rate-<%= review._id %>-<%= i %>" 
              name="review[rating]"
              value="<%= i %>" 
              <%= review.rating === i ? "checked" : "" %>
            >
            <label for="edit-rate-<%= review._id %>-<%= i %>"><%= i %></label>
          <% } %>
        </fieldset>

        <textarea 
          name="review[comment]" 
          class="form-control mt-2" 
          rows="3" 
          required
        ><%= review.comment %></textarea>

        <button class="btn btn-primary btn-sm mt-3">Save Changes</button>
      </form>

      <% } %>

    </div>
  <% }); %>

  <!-- ================= ADD REVIEW FORM ================= -->
  <% if (currUser) { %>
    <div class="card shadow-sm p-3 mt-4">

      <h5 class="fw-semibold mb-3">Write a Review</h5>

      <form action="/listings/<%= listing._id %>/reviews" method="POST" class="vstack gap-3">

        <!-- Animated Star Rating -->
        <fieldset class="starability-heart animated-rate">
          <% for (let i = 1; i <= 5; i++) { %>
            <input type="radio" id="rate-<%= i %>" name="review[rating]" value="<%= i %>">
            <label for="rate-<%= i %>" title="<%= i %> stars"><%= i %></label>
          <% } %>
        </fieldset>

        <!-- ⭐ Rating Error -->
      <p id="ratingError" class="text-danger small d-none">
        Please select a rating before submitting.
      </p>

      <!-- 📝 Comment -->
      <div>
        <label class="form-label fw-semibold mb-1">Add a comment</label>
        <textarea 
          name="review[comment]" 
          class="form-control" 
          rows="3" 
          required
          placeholder="Write your review..."
        ></textarea>
      </div>


        <button class="btn btn-primary w-100 mt-2">Submit Review</button>
      </form>
    </div>
  <% } %>

</div>

<!-- ================= MAP ================= -->
<div class="mx-auto mb-4" style="max-width:650px;">
  <h3>Where you are</h3>

  <% 
    const lat = listing.geometry?.coordinates?.[1];
    const lng = listing.geometry?.coordinates?.[0];
    const geometrySafe = JSON.stringify(listing.geometry || null);
    const invalid = !lat || !lng || (lat === 0 && lng === 0);
  %>

  <% if (invalid) { %>
      <div class="alert alert-warning text-center">Map not available for this listing</div>
  <% } else { %>
      <div
        id="map"
        data-geometry='<%= geometrySafe %>'
        data-location="<%= listing.location %>"
        style="height:300px; border-radius:10px;"
      ></div>
  <% } %>
</div>

<!-- ================= SCRIPTS ================= -->
<script>
document.addEventListener("DOMContentLoaded", function () {

  /* ================= IMAGE MODAL ================= */
  const img = document.getElementById("listingImage");
  const modal = document.getElementById("imageModal");
  const modalImg = document.getElementById("modalImage");
  const close = document.getElementById("closeModal");

  if (img) {
    img.onclick = function () {
      modal.style.display = "flex";
      modalImg.src = this.src;
    };
  }

  if (close) close.onclick = () => modal.style.display = "none";
  if (modal) modal.addEventListener("click", (e) => {
    if (e.target === modal) modal.style.display = "none";
  });

  /* ================= PRICE CALCULATION & DATE LOGIC ================= */
  const checkInInput = document.getElementById("checkIn");
  const checkOutInput = document.getElementById("checkOut");
  const nightsCount = document.getElementById("nightsCount");
  const totalPriceEl = document.getElementById("totalPrice");
  const reserveBtn = document.getElementById("reserveBtn");

  const pricePerNight = Number("<%= listing.price %>") || 0;

  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  const minDateStr = tomorrow.toISOString().split("T")[0];

  const sixMonthsLater = new Date();
  sixMonthsLater.setMonth(sixMonthsLater.getMonth() + 6);
  const maxDateStr = sixMonthsLater.toISOString().split("T")[0];

  if (checkInInput && checkOutInput) {
    checkInInput.min = minDateStr;
    checkInInput.max = maxDateStr;
    checkOutInput.min = minDateStr;
    checkOutInput.max = maxDateStr;
  }

  function calculatePrice() {
    const checkInVal = checkInInput?.value;
    const checkOutVal = checkOutInput?.value;

    if (!checkInVal || !checkOutVal) {
      nightsCount.textContent = "0";
      totalPriceEl.textContent = "₹0";
      reserveBtn.disabled = true;
      return;
    }

    const checkInDate = new Date(checkInVal);
    const checkOutDate = new Date(checkOutVal);

    if (checkOutDate <= checkInDate) {
      nightsCount.textContent = "Invalid";
      totalPriceEl.textContent = "—";
      reserveBtn.disabled = true;
      return;
    }

    const diffTime = checkOutDate - checkInDate;
    const nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    nightsCount.textContent = nights;
    totalPriceEl.textContent = "₹" + (nights * pricePerNight).toLocaleString("en-IN");
    reserveBtn.disabled = false;
  }

  if (checkInInput) checkInInput.addEventListener("change", calculatePrice);
  if (checkOutInput) checkOutInput.addEventListener("change", calculatePrice);

  if (checkInInput) {
    checkInInput.addEventListener("change", () => {
      if (checkOutInput) checkOutInput.min = checkInInput.value || minDateStr;
      calculatePrice();
    });
  }

  /* ================= REVIEW VALIDATION ================= */
  const reviewForm = document.getElementById("reviewForm");
  if (reviewForm) {
    const ratingInputs = reviewForm.querySelectorAll(
      'input[name="review[rating]"]'
    );
    const ratingError = document.getElementById("ratingError");

    reviewForm.addEventListener("submit", (e) => {
      const ratingSelected = [...ratingInputs].some(r => r.checked);

      if (!ratingSelected) {
        e.preventDefault(); // ⛔ stop submit
        ratingError.classList.remove("d-none");
        ratingError.scrollIntoView({ behavior: "smooth", block: "center" });
      } else {
        ratingError.classList.add("d-none");
      }
    });
  }

});
</script>

<script src="/js/showMap.js"></script>
