<% layout("./layouts/boilerplate") %>
<% bodyClass = "show-page" %>

<!-- ================= BACK BUTTON ================= -->
<div class="container mt-3 mb-2">
  <a href="javascript:history.back()" class="btn btn-light border d-inline-flex align-items-center gap-2">
    <i class="fa-solid fa-arrow-left"></i>
    Back
  </a>
</div>

<!-- ================= LISTING ================= -->
<div class="card mx-auto shadow-sm mb-4 show-listing-card" style="max-width:650px;">
  <img
    src="<%= listing.image.url %>"
    class="card-img-top show-clickable-img"
    id="listingImage"
    alt="listing image"
    style="height:260px; object-fit:cover;"
  />

  <div class="card-body text-center">
    <h4 class="mb-1"><%= listing.title %></h4>
    <p class="mt-3 mb-0"><%= listing.description %></p>
  </div>
</div>

<!-- ================= IMAGE MODAL ================= -->
<div id="imageModal" class="image-modal">
  <span class="close-modal" id="closeModal">&times;</span>
  <img class="image-modal-content" id="modalImage">
</div>

<!-- ================= OWNER ACTIONS ================= -->
<% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
  <div class="mx-auto mb-4 d-flex gap-2 justify-content-center" style="max-width:650px;">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary btn-sm">Edit</a>
    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this listing?')">
      <button class="btn btn-outline-danger btn-sm">Delete</button>
    </form>
  </div>
<% } %>

<!-- ================= BOOKING FORM ================= -->
<% if (currUser) { %>
<div class="mx-auto mb-4" style="max-width:650px;">
  <div class="card shadow-sm p-4">
    <h5 class="mb-3 fw-semibold">Reserve this stay</h5>

    <form action="/bookings/<%= listing._id %>" method="POST" class="row g-3">

      <div class="col-md-6">
        <label class="form-label small text-muted">Check-in</label>
        <div class="position-relative">
          <i class="fa-solid fa-calendar-days position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
          <input type="date" name="checkIn" class="form-control ps-5" required>
        </div>
      </div>

      <div class="col-md-6">
        <label class="form-label small text-muted">Check-out</label>
        <div class="position-relative">
          <i class="fa-solid fa-calendar-days position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
          <input type="date" name="checkOut" class="form-control ps-5" required>
        </div>
      </div>

      <div class="col-12">
        <button class="btn btn-danger w-100 py-2">Reserve</button>
      </div>

      <p class="text-muted small text-center mt-1">
        Booking for today or past dates is not allowed.
      </p>

    </form>
  </div>
</div>
<% } else { %>
<p class="text-center">
  <a href="/users/login">Login</a> to book this stay
</p>
<% } %>

<!-- ================= REVIEWS ================= -->
<div class="mx-auto mb-4" style="max-width:650px;">

  <h3 class="mb-3">Reviews</h3>

  <!-- ================= SHOW ALL REVIEWS ================= -->
  <% if (listing.reviews.length === 0) { %>
    <p class="text-muted text-center">No reviews yet. Be the first!</p>
  <% } %>

  <% listing.reviews.forEach(review => { %>
    <div class="card shadow-sm p-3 mb-3">

      <!-- Username -->
      <h6 class="fw-semibold mb-1">
        <%= review.author ? review.author.username : "Deleted User" %>
      </h6>

      <!-- Starability Read-Only Stars -->
      <div class="starability-result" data-rating="<%= review.rating %>"></div>

      <!-- Comment -->
      <p class="mt-2 mb-1"><%= review.comment %></p>

      <!-- Delete Button (only for author) -->
      <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
        <form 
          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" 
          method="POST"
          class="mt-2"
          onsubmit="return confirm('Delete this review?')"
        >
          <button class="btn btn-sm btn-outline-danger">Delete</button>
        </form>
      <% } %>

    </div>
  <% }); %>

  <!-- ================= ADD REVIEW FORM ================= -->
  <% if (currUser) { %>
    <div class="card shadow-sm p-3 mt-4">

      <h5 class="fw-semibold mb-3">Write a Review</h5>

      <form action="/listings/<%= listing._id %>/reviews" method="POST" class="vstack gap-3">

        <!-- Star Rating -->
        <div>
          <label class="form-label">Rating</label>

          
<fieldset class="starability-heart">
  <legend>First rating:</legend>
  <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="rating" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="rating" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="rating" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="rating" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="rating" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>


        <!-- Comment -->
        <div>
          <label class="form-label">Comment</label>
          <textarea 
            name="review[comment]" 
            class="form-control" 
            rows="3" 
            required 
            placeholder="Write your review..."
          ></textarea>
        </div>

        <button class="btn btn-primary w-100">Submit Review</button>
      </form>
    </div>
  <% } else { %>
    <p class="text-center mt-3">
      <a href="/users/login">Login</a> to write a review.
    </p>
  <% } %>

</div>
<!-- ================= MAP ================= -->
<div class="mx-auto mb-4" style="max-width:650px;">
  <h3>Where you are</h3>

  <% 
    const lat = listing.geometry?.coordinates?.[1];
    const lng = listing.geometry?.coordinates?.[0];
    const isInvalid = !lat || !lng || (lat === 0 && lng === 0);
  %>

  <% if (isInvalid) { %>
      <div class="alert alert-warning text-center">
        Map not available for this listing
      </div>
  <% } else { %>
      <div
        id="map"
        data-lat="<%= lat %>"
        data-lng="<%= lng %>"
        data-location="<%= listing.location %>"
        style="height:300px;border-radius:10px;"
      ></div>
  <% } %>
</div>

  /* ================= BOOKING DATE LOGIC ================= */
  const checkIn = document.querySelector("input[name='checkIn']");
  const checkOut = document.querySelector("input[name='checkOut']");

  if (checkIn && checkOut) {

    // 👉 Tomorrow (no booking today or past)
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);

    // 👉 Max booking = 6 months from today
    const sixMonthsLater = new Date();
    sixMonthsLater.setMonth(sixMonthsLater.getMonth() + 6);

    const minDate = tomorrow.toISOString().split("T")[0];
    const maxDate = sixMonthsLater.toISOString().split("T")[0];

    // Apply limits
    checkIn.min = minDate;
    checkIn.max = maxDate;

    checkOut.min = minDate;
    checkOut.max = maxDate;

    // When check-in changes, update check-out
    checkIn.addEventListener("change", () => {
      checkOut.min = checkIn.value;
    });
  }

  /* ================= MAP ================= */
  if (typeof L !== "undefined") {
    const mapDiv = document.getElementById("map");
    if (!mapDiv) return;

    const lat = mapDiv.dataset.lat;
    const lng = mapDiv.dataset.lng;

    const map = L.map("map").setView([lat, lng], 14);
    L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
      { attribution: "© Esri" }
    ).addTo(map);

    L.marker([lat, lng])
      .addTo(map)
      .bindPopup(mapDiv.dataset.location);
  }
});
</script>
